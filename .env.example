# Copy to .env and fill in. .env is gitignored -- keep it that way.
# This token is equivalent to access to the Instagram account. Do not paste it
# into a chat window, a prompt, or an issue; agents read it from here instead.

IG_ACCESS_TOKEN=

# Optional -- probe.py discovers these, but pinning them skips a lookup.
IG_USER_ID=
GRAPH_VERSION=
