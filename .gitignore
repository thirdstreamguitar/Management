# Secrets -- never commit. The token is equivalent to account access.
.env
.env.*
!.env.example

# Local data. capabilities.json IS committed (no secrets, and the agent reads it).
data/*.db
data/*.db-journal
data/*.sqlite

# Media library lives on the PC, not in git.
library/
inbox/
renders/

__pycache__/
*.pyc
.venv/
